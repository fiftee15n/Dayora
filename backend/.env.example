# Copy to .env and adjust
APP_ENV=development
# SQLite (default) or PostgreSQL / Neon:
# DATABASE_URL=postgresql+psycopg://user:password@host/dayora
DATABASE_URL=sqlite:///./dayora.db
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
