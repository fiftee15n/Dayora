# Copy to .env and adjust
APP_ENV=development
# SQLite (default) or PostgreSQL / Neon:
# DATABASE_URL=postgresql+psycopg://user:password@host/dayora
DATABASE_URL=sqlite:///./dayora.db
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Public URL of the web app (used for links in emails)
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRE_MINUTES=30

# Outgoing email for password resets. Leave SMTP_HOST empty to log emails instead.
# In production (APP_ENV=production) JWT_SECRET must be 32+ random characters.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Dayora <no-reply@dayora.app>
SMTP_STARTTLS=true
SMTP_SSL=false

# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com and SMTP_PASSWORD=<16-char App password>
# (needs 2-Step Verification; create it at https://myaccount.google.com/apppasswords).

# Sign-up verification codes
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_SECONDS=60

# Google sign-in: the "Web application" OAuth client ID (comma-separate several). Empty disables it.
GOOGLE_CLIENT_IDS=
